{
  "name": "@vaur94/opencode2-extra-tool",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Extra todowrite tool plugin for OpenCode V2.",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugur-murat-alt/opencode2-extra-tool.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outfile=dist/plugin.js --target=bun",
    "check": "bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "todo"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17203"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
